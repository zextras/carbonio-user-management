arch=('x86_64')
section="admin"
priority="optional"
url="https://www.zextras.com/"
license=("AGPL-3.0-only")
depends=(
  "pending-setups"
  "service-discover"
)
source=(
  "121-${pkgname}.sh"
  "${pkgname}"
  "${pkgname}.hcl"
  "${pkgname}-runner"
  "${pkgname}.service"
  "${pkgname}-legacy.service"
  "${pkgname}-setup"
  "${pkgname}-sidecar.service"
  "${pkgname}-sidecar-legacy.service"
  "intentions.json"
  "policies.json"
  "service-protocol.json"
)
sha256sums=(
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
)
backup=(
  "etc/zextras/service-discover/${pkgname}.hcl"
  "etc/carbonio/user-management/config.properties"
)

_package() {
  install -Dm644 "${srcdir}/121-${pkgname}.sh" \
    "${pkgdir}/etc/zextras/pending-setups.d/121-${pkgname}.sh"
  install -Dm755 "${srcdir}/${pkgname}" \
    "${pkgdir}/usr/bin/${pkgname}"
  install -Dm755 "${srcdir}/${pkgname}-setup" \
    "${pkgdir}/usr/bin/${pkgname}-setup"
  install -Dm755 "${srcdir}/${pkgname}-runner" \
    "${pkgdir}/usr/share/carbonio/${pkgname}-runner"

  install -Dm644 "${srcdir}/${pkgname}.hcl" \
    "${pkgdir}/etc/zextras/service-discover/${pkgname}.hcl"
  install -Dm644 "${srcdir}/intentions.json" \
    "${pkgdir}/etc/carbonio/user-management/service-discover/intentions.json"
  install -Dm644 "${srcdir}/policies.json" \
    "${pkgdir}/etc/carbonio/user-management/service-discover/policies.json"
  install -Dm644 "${srcdir}/service-protocol.json" \
    "${pkgdir}/etc/carbonio/user-management/service-discover/service-protocol.json"
}

_package_legacy() {
  install -Dm644 "${srcdir}/${pkgname}-legacy.service" \
    "${pkgdir}/lib/systemd/system/${pkgname}.service"
  install -Dm644 "${srcdir}/${pkgname}-sidecar-legacy.service" \
    "${pkgdir}/lib/systemd/system/${pkgname}-sidecar.service"
}

_package_systemd() {
  install -Dm644 "${srcdir}/${pkgname}.service" \
    "${pkgdir}/lib/systemd/system/${pkgname}.service"
  install -Dm644 "${srcdir}/${pkgname}-sidecar.service" \
    "${pkgdir}/lib/systemd/system/${pkgname}-sidecar.service"
}

package() {
  _package
  _package_systemd
}

package__rocky_8() {
  _package
  _package_legacy
}

package__rocky_9() {
  _package
  _package_systemd
}

package__ubuntu_jammy() {
  _package
  _package_legacy
}

package__ubuntu_noble() {
  _package
  _package_systemd
}

postinst() {
  getent group 'carbonio-user-management' >/dev/null \
    || groupadd -r 'carbonio-user-management'
  getent passwd 'carbonio-user-management' >/dev/null \
    || useradd -r -M -g 'carbonio-user-management' -s /sbin/nologin 'carbonio-user-management'

  mkdir -p "/var/log/carbonio/user-management/"
  chown carbonio-user-management:carbonio-user-management "/var/log/carbonio/user-management"

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload &>/dev/null || :
    systemctl enable carbonio-user-management.service &>/dev/null || :
    systemctl enable carbonio-user-management-sidecar.service &>/dev/null || :
  fi

  echo "======================================================"
  echo "Carbonio User Management installed successfully!"
  echo "You must run pending-setups to configure it correctly."
  echo "======================================================"
}

prerm() {
  if [ -d /run/systemd/system ]; then
    # Deregister service from Consul before stopping (service token has service:write)
    TOKEN_FILE="/etc/carbonio/user-management/service-discover/token"
    if [ -f "$TOKEN_FILE" ]; then
      CONSUL_HTTP_TOKEN=$(cat "$TOKEN_FILE") \
        consul services deregister /etc/zextras/service-discover/carbonio-user-management.hcl \
        2>/dev/null || true
    fi

    systemctl --no-reload disable --now carbonio-user-management.service &>/dev/null || :
    systemctl --no-reload disable --now carbonio-user-management-sidecar.service &>/dev/null || :
  fi
}

postrm() {
  # Remove config and service-discover files, but KEEP the token file.
  # The token file is the reference to the Consul ACL token we created.
  # It will be validated and reused or cleaned up at the next setup.
  rm -f /etc/carbonio/user-management/service-discover/intentions.json
  rm -f /etc/carbonio/user-management/service-discover/policies.json
  rm -f /etc/carbonio/user-management/service-discover/service-protocol.json
  rm -f /etc/carbonio/user-management/config.properties

  rm -f /etc/systemd/system/carbonio-user-management.service.d/override.conf
  rmdir /etc/systemd/system/carbonio-user-management.service.d/ 2>/dev/null || :
  rm -f /etc/zextras/pending-setups.d/121-carbonio-user-management.sh
  rm -f /etc/zextras/pending-setups.d/done/121-carbonio-user-management.sh

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload &>/dev/null || :
  fi
}
