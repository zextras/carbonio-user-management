depends=(
  "carbonio-openjdk"
  "pending-setups"
  "service-discover"
)
source=(
  "121-${pkgname}.sh"
  "${pkgname}"
  "${pkgname}.hcl"
  "${pkgname}.jar"
  "${pkgname}.service"
  "${pkgname}-setup"
  "${pkgname}-sidecar.service"
  "intentions.json"
  "policies.json"
  "service-protocol.json"
)
