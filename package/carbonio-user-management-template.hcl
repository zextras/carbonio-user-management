// Generated by carbonio-user-management-hcl from the packaged template on every
// upgrade and setup: local edits to this file are overwritten.
// To change the values, set them in /etc/zextras/service-discover/carbonio-user-management.env
// (KEY=value lines; "carbonio-user-management-hcl show" lists keys and defaults),
// then run carbonio-user-management-setup.

services {
  check {
    http     = "http://127.78.0.5:10000/q/health/live"
    method   = "GET"
    timeout  = "{{ or (env "CHECK_TIMEOUT") "1s" }}"
    interval = "{{ or (env "CHECK_INTERVAL") "5s" }}"
  }
  connect {
    sidecar_service {
      proxy {
        local_service_address = "127.78.0.5"
        upstreams = [
          {
            destination_name   = "carbonio-mailbox-internal-api"
            local_bind_address = "127.78.0.5"
            local_bind_port    = 20001
          }
        ]
      }
    }
  }
  name = "carbonio-user-management"
  port = 10000
}
