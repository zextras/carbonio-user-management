set -euo pipefail

SD_DIR="${SD_DIR:-/etc/zextras/service-discover}"
NAME="carbonio-user-management"
TEMPLATE="${SD_DIR}/templates/${NAME}-template.hcl"
LIVE="${SD_DIR}/${NAME}.hcl"
ENVFILE="${SD_DIR}/${NAME}.env"
BAK="${LIVE}.bak"
MARKER="Generated by carbonio-user-management-hcl"
DURATION_RE='^([0-9]+(\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$'

usage() {
  echo "Usage: ${0##*/} {migrate|render|show}" >&2
  exit 2
}

hcl_paths() {
  awk '
    function path(k,   i, p) {
      p = ""
      for (i = 1; i <= depth; i++) p = p stack[i] "."
      return p k
    }
    {
      line = $0
      sub(/^[ \t]+/, "", line)
      sub(/[ \t]+$/, "", line)
      sub(/"[ \t]*,?[ \t]*(\/\/|#).*$/, "\"", line)
      if (line == "" || line ~ /^\/\// || line ~ /^#/) next
      if (line ~ /^[A-Za-z0-9_]+[ \t]*=[ \t]*".*",?$/) {
        k = line; sub(/[ \t]*=.*/, "", k)
        v = line; sub(/^[^=]*=[ \t]*"/, "", v); sub(/",?$/, "", v)
        print path(k) "\t" v
      } else if (line ~ /^[A-Za-z0-9_]+[ \t]*(=[ \t]*)?\{$/ || line ~ /^[A-Za-z0-9_]+[ \t]*=[ \t]*\[$/) {
        k = line; sub(/[ \t]*(=[ \t]*)?[\{\[]$/, "", k)
        stack[++depth] = k
      } else if (line ~ /^\{$/) {
        stack[++depth] = "[]"
      } else if (line ~ /^[\}\]]/) {
        if (depth > 0) depth--
      }
    }
  '
}

KEYS=()
DEFAULTS=()
KPATHS=()

discover() {
  local p v
  [[ -r "${TEMPLATE}" ]] || { echo "Template not found: ${TEMPLATE}" >&2; exit 1; }
  while IFS=$'\t' read -r p v; do
    while [[ "${v}" =~ env\ \"([A-Za-z0-9_]+)\"\)\ \"([^\"]*)\" ]]; do
      KEYS+=("${BASH_REMATCH[1]}")
      DEFAULTS+=("${BASH_REMATCH[2]}")
      KPATHS+=("${p}")
      v="${v#*"${BASH_REMATCH[0]}"}"
    done
  done < <(hcl_paths < "${TEMPLATE}")
}

index_of() {
  local i
  for i in "${!KEYS[@]}"; do
    if [[ "${KEYS[i]}" == "$1" ]]; then
      echo "${i}"
      return 0
    fi
  done
  return 1
}

valid_value() {
  local def="$2" val="$3"
  if [[ "${def}" =~ ${DURATION_RE} ]]; then
    [[ "${val}" =~ ${DURATION_RE} ]]
  elif [[ "${def}" =~ ^[0-9]+$ ]]; then
    [[ "${val}" =~ ^[0-9]+$ ]]
  else
    [[ "${val}" != *'"'* && "${val}" != *"\\"* && ! "${val}" =~ [[:cntrl:]] ]]
  fi
}

declare -A PROVIDED=()
tmp=""
trap '[[ -z "${tmp}" ]] || rm -f "${tmp}"' EXIT

load_env() {
  local line key val n=0
  [[ -f "${ENVFILE}" ]] || return 0
  while IFS= read -r line || [[ -n "${line}" ]]; do
    n=$((n + 1))
    line="${line%"${line##*[![:space:]]}"}"
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "${line}" || "${line}" == \#* ]] && continue
    if [[ ! "${line}" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
      echo "Warning: ${ENVFILE}:${n}: malformed line ignored: ${line}" >&2
      continue
    fi
    key="${BASH_REMATCH[1]}"
    val="${BASH_REMATCH[2]}"
    if [[ "${val}" =~ ^\"(.*)\"$ || "${val}" =~ ^\'(.*)\'$ ]]; then
      val="${BASH_REMATCH[1]}"
    fi
    if ! index_of "${key}" > /dev/null; then
      echo "Warning: ${ENVFILE}:${n}: unknown key ${key} ignored" >&2
      continue
    fi
    PROVIDED["${key}"]="${val}"
  done < "${ENVFILE}"
}

cmd_migrate() {
  local source="" i val collected=() key
  [[ -f "${ENVFILE}" ]] && return 0
  discover
  if [[ -f "${LIVE}" ]]; then
    grep -qF "${MARKER}" "${LIVE}" && return 0
    source="${LIVE}"
  elif [[ -f "${LIVE}.rpmsave" ]] && ! grep -qF "${MARKER}" "${LIVE}.rpmsave"; then
    source="${LIVE}.rpmsave"
  else
    return 0
  fi
  local old
  old="$(hcl_paths < "${source}")"
  for i in "${!KEYS[@]}"; do
    val="$(awk -F'\t' -v p="${KPATHS[i]}" '$1 == p { print $2; exit }' <<< "${old}")"
    if [[ -n "${val}" && "${val}" != "${DEFAULTS[i]}" ]]; then
      collected+=("${KEYS[i]}=${val}")
    fi
  done
  if ((${#collected[@]} > 0)); then
    tmp="$(mktemp "${SD_DIR}/.${NAME}.env.XXXXXX")"
    {
      echo "# Overrides for ${NAME}.hcl, see ${NAME}-hcl show"
      echo "# Apply with ${NAME}-setup"
      printf '%s\n' "${collected[@]}"
    } > "${tmp}"
    chmod 0644 "${tmp}"
    mv -f "${tmp}" "${ENVFILE}"
    for key in "${collected[@]}"; do
      echo "Migrated ${key} from ${source}"
    done
  fi
  if [[ "${source}" == "${LIVE}.rpmsave" && ! -e "${BAK}" ]]; then
    mv "${source}" "${BAK}"
    echo "Previous ${source} moved to ${BAK}"
  fi
}

backup_live() {
  local dest="${BAK}"
  [[ -f "${LIVE}" ]] || return 0
  grep -qF "${MARKER}" "${LIVE}" && return 0
  [[ -e "${dest}" ]] && dest="${BAK}.$(date +%Y%m%d%H%M%S)"
  cp -p "${LIVE}" "${dest}"
  echo "Previous ${LIVE} kept as ${dest}"
}

cmd_render() {
  local i key vars=()
  discover
  load_env
  for key in "${!PROVIDED[@]}"; do
    i="$(index_of "${key}")"
    if ! valid_value "${key}" "${DEFAULTS[i]}" "${PROVIDED[${key}]}"; then
      echo "Invalid value for ${key}: '${PROVIDED[${key}]}' (expected like ${DEFAULTS[i]})" >&2
      exit 1
    fi
    vars+=("${key}=${PROVIDED[${key}]}")
  done
  tmp="$(mktemp "${SD_DIR}/.${NAME}.hcl.XXXXXX")"
  env -i PATH="${PATH}" "${vars[@]}" "${CONSUL_TEMPLATE:-consul-template}" \
    -template "${TEMPLATE}:${tmp}" -once > /dev/null
  if [[ ! -s "${tmp}" ]] || ! grep -qF "${MARKER}" "${tmp}"; then
    echo "Rendering ${TEMPLATE} produced no valid output" >&2
    exit 1
  fi
  chmod 0644 "${tmp}"
  backup_live
  mv -f "${tmp}" "${LIVE}"
  echo "Rendered ${LIVE}"
}

rep() {
  local out="" n="$1"
  while ((n-- > 0)); do out+="─"; done
  printf '%s' "${out}"
}

cmd_show() {
  local i key cur w1=3 w2=7 w3=7 invalid=0
  local -a cur_vals=()
  discover
  load_env
  for i in "${!KEYS[@]}"; do
    key="${KEYS[i]}"
    cur="${DEFAULTS[i]}"
    if [[ -v "PROVIDED[${key}]" ]]; then
      cur="${PROVIDED[${key}]}"
      if ! valid_value "${key}" "${DEFAULTS[i]}" "${cur}"; then
        cur="${cur} (invalid, not applied)"
        invalid=1
      fi
    fi
    cur_vals[i]="${cur}"
    ((${#key} > w1)) && w1=${#key}
    ((${#DEFAULTS[i]} > w2)) && w2=${#DEFAULTS[i]}
    ((${#cur} > w3)) && w3=${#cur}
  done
  echo
  echo "Sidecar Config (overridable by ${ENVFILE}, apply with ${NAME}-setup)"
  echo
  echo "┌─$(rep "${w1}")─┬─$(rep "${w2}")─┬─$(rep "${w3}")─┐"
  printf '│ %-*s │ %-*s │ %-*s │\n' "${w1}" Key "${w2}" Default "${w3}" Current
  echo "├─$(rep "${w1}")─┼─$(rep "${w2}")─┼─$(rep "${w3}")─┤"
  for i in "${!KEYS[@]}"; do
    printf '│ %-*s │ %-*s │ %-*s │\n' "${w1}" "${KEYS[i]}" "${w2}" "${DEFAULTS[i]}" "${w3}" "${cur_vals[i]}"
  done
  echo "└─$(rep "${w1}")─┴─$(rep "${w2}")─┴─$(rep "${w3}")─┘"
  echo
  ((invalid == 0))
}

case "${1:-}" in
  migrate) cmd_migrate ;;
  render) cmd_render ;;
  show) cmd_show ;;
  *) usage ;;
esac
