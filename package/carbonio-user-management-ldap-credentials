set -euo pipefail

service=carbonio-user-management
dn="uid=${service},cn=appaccts,cn=zimbra"
username_key="${service}/ldap-username"
password_key="${service}/ldap-password"
configd=/opt/zextras/bin/configd
zmlocalconfig=/opt/zextras/bin/zmlocalconfig
ldapbin=/opt/zextras/common/bin

usage() {
  echo "Usage: CONSUL_HTTP_TOKEN=<token with write on ${service}/> $0 [--rotate]" >&2
  exit 1
}

rotate=false
case "${1:-}" in
  "") ;;
  --rotate) rotate=true ;;
  *) usage ;;
esac

if [[ $(id -u) -ne 0 ]]; then
  echo "Please run as root" >&2
  exit 1
fi
if [[ -z ${CONSUL_HTTP_TOKEN:-} ]]; then
  usage
fi
for tool in ldapsearch ldapadd ldappasswd ldapwhoami; do
  if [[ ! -x ${ldapbin}/${tool} ]]; then
    echo "${ldapbin}/${tool} not found" >&2
    exit 1
  fi
done

lc() {
  if [[ -x ${configd} ]]; then
    "${configd}" localconfig -q -s -x -m nokey "$1" 2>/dev/null || true
  else
    "${zmlocalconfig}" -q -s -x -m nokey "$1" 2>/dev/null || true
  fi
}

save_if_absent() {
  local key=$1 value=$2
  if ! consul kv get "${key}" >/dev/null 2>&1; then
    printf '%s' "${value}" | consul kv put "${key}" - >/dev/null
  fi
  consul kv get "${key}"
}

admin_dn=$(lc zimbra_ldap_userdn)
admin_password=$(lc zimbra_ldap_password)
master_url=$(lc ldap_master_url)
read_url=$(lc ldap_url)
if [[ -z ${admin_dn} || -z ${admin_password} || -z ${master_url} || -z ${read_url} ]]; then
  echo "Missing LDAP settings in localconfig (zimbra_ldap_userdn, zimbra_ldap_password, ldap_master_url, ldap_url)" >&2
  exit 1
fi

tls=()
if [[ $(lc ldap_starttls_supported) == 1 && $(lc ldap_starttls_required) != false &&
  $(lc zimbra_require_interprocess_security) == 1 ]]; then
  tls=(-ZZ)
  export LDAPTLS_CACERTDIR=/opt/zextras/conf/ca
fi

as_admin() {
  local tool=$1
  shift
  "${ldapbin}/${tool}" -x "${tls[@]}" -H "${master_url}" -D "${admin_dn}" \
    -y <(printf '%s' "${admin_password}") "$@"
}

if [[ ${rotate} == true ]]; then
  openssl rand -hex 16 | tr -d '\n' | consul kv put "${password_key}" - >/dev/null
fi
save_if_absent "${username_key}" "${dn}" >/dev/null
password=$(save_if_absent "${password_key}" "$(openssl rand -hex 16 | tr -d '\n')")

set +e
as_admin ldapsearch -LLL -b "${dn}" -s base "(objectClass=*)" 1.1 >/dev/null 2>&1
found=$?
set -e
case ${found} in
  0) ;;
  32)
    as_admin ldapadd >/dev/null <<LDIF
dn: ${dn}
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: ${service}
cn: ${service}
sn: ${service}
description: Read-only directory account of ${service}
LDIF
    echo "Created ${dn}"
    ;;
  *)
    echo "Cannot search ${dn} on ${master_url} (ldapsearch exit ${found})" >&2
    exit 1
    ;;
esac

as_admin ldappasswd -T <(printf '%s' "${password}") "${dn}" >/dev/null
echo "Password of ${dn} set from Consul KV ${password_key}"

as_service() {
  local tool=$1
  shift
  "${ldapbin}/${tool}" -x "${tls[@]}" -H "${read_url}" -D "${dn}" \
    -y <(printf '%s' "${password}") "$@"
}

for attempt in $(seq 1 30); do
  if as_service ldapwhoami >/dev/null 2>&1; then
    break
  fi
  if [[ ${attempt} == 30 ]]; then
    echo "${dn} cannot bind to ${read_url}" >&2
    exit 1
  fi
  sleep 1
done

if ! as_service ldapsearch -LLL -b cn=config,cn=zimbra -s base "(objectClass=*)" \
  zimbraAuthTokenKey 2>/dev/null | grep '^zimbraAuthTokenKey:' >/dev/null; then
  echo "${dn} cannot read the directory: every LDAP server needs carbonio-directory-server with the ${service} access rules" >&2
  exit 1
fi
echo "${dn} binds and reads the directory"
