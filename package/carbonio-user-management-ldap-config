#!/bin/bash

set -euo pipefail

configd=/opt/zextras/bin/configd
zmlocalconfig=/opt/zextras/bin/zmlocalconfig
owner=carbonio-user-management
dir=/run/carbonio-user-management
out="${dir}/ldap.properties"

lc() {
  if [[ -x ${configd} || -x ${zmlocalconfig} ]]; then
    "${configd}" localconfig -q -s -x -m nokey "$1" 2>/dev/null || true
  else
    "${zmlocalconfig}" -q -s -x -m nokey "$1" 2>/dev/null || true
  fi
}

escape() {
  local value=${1//\\/\\\\}
  if [[ ${value} == [[:space:]]* ]]; then
    value="\\${value}"
  fi
  printf '%s' "${value}"
}

property() {
  if [[ -n $2 ]]; then
    printf '%s=%s\n' "$1" "$(escape "$2")"
  fi
}

umask 077
mkdir -p "${dir}"
tmp=$(mktemp "$(dirname "${dir}")/.carbonio-user-management-ldap.XXXXXX")
trap 'rm -f "${tmp}"' EXIT

if [[ -x ${configd} || -x ${zmlocalconfig} ]]; then
  {
    property networking-config.carbonio.ldap.url "$(lc ldap_url)"
    if [[ $(lc ldap_starttls_supported) == 1 && $(lc ldap_starttls_required) != false &&
      $(lc zimbra_require_interprocess_security) == 1 ]]; then
      property networking-config.carbonio.ldap.starttls true
    fi
    property application-config.ldap.bind-dn "$(lc zimbra_ldap_userdn)"
    property application-config.ldap.bind-password "$(lc zimbra_ldap_password)"
  } >"${tmp}"
fi

chown "${owner}:${owner}" "${tmp}"
mv -f "${tmp}" "${out}"
