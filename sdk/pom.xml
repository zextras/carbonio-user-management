<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.zextras.carbonio.quarkus</groupId>
    <artifactId>carbonio-quarkus-extensions-rest-sdk-parent</artifactId>
    <version>1.11.2-1</version>
    <relativePath/>
  </parent>

  <groupId>com.zextras.carbonio.user-management</groupId>
  <artifactId>carbonio-user-management-rest-sdk</artifactId>
  <version>${revision}${changelist}</version>
  <name>Carbonio User Management - REST SDK</name>

  <properties>
    <revision>0.0.0</revision>
    <changelist>-SNAPSHOT</changelist>

    <sdk.openapi.spec>${project.basedir}/../app/docs/openapi.yaml</sdk.openapi.spec>
    <sdk.base.package>com.zextras.carbonio.user_management.sdk</sdk.base.package>
  </properties>

  <!--
    carbonio-quarkus-extensions-rest-sdk-parent declares its dependency on
    carbonio-quarkus-extensions-rest-sdk-support using dollar-brace project.version. That
    expression is re-evaluated against whichever project inherits the POM, so a cross-repo
    consumer like this module, which necessarily overrides revision/changelist to its own
    CI-friendly values, would otherwise resolve the wrong (own) version instead of the parent's
    1.11.2-1. Pin it explicitly.
  -->
  <dependencies>
    <dependency>
      <groupId>com.zextras.carbonio.quarkus</groupId>
      <artifactId>carbonio-quarkus-extensions-rest-sdk-support</artifactId>
      <version>1.11.2-1</version>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <id>zextras-java-sdk</id>
      <name>Zextras public maven repo</name>
      <url>https://zextras.jfrog.io/artifactory/java-sdk</url>
    </repository>
  </repositories>
</project>
